{
  "name": "Signal",
  "type": "object",
  "properties": {
    "setup_id": {
      "type": "string",
      "description": "Which named setup fired, e.g. C_PULLBACK_LONG. Empty for score-only signals."
    },
    "setup_name": {
      "type": "string"
    },
    "tier": {
      "type": "string",
      "enum": [
        "A+",
        "A",
        "B",
        "C",
        "NO_TRADE"
      ],
      "description": "Evidence tier assigned from out-of-sample backtest statistics, not from wording"
    },
    "evidence_score": {
      "type": "number",
      "description": "0-100 weight of directional evidence. NOT a probability: long and short always sum to 100, so 50 means no information."
    },
    "expected_r": {
      "type": "number",
      "description": "Out-of-sample expectancy of this setup in R, from quant/ backtests"
    },
    "historical_win_rate": {
      "type": "number",
      "description": "Measured out-of-sample win rate of this setup, as a percentage"
    },
    "historical_sample": {
      "type": "number",
      "description": "Number of out-of-sample trades behind the statistics above"
    },
    "historical_profit_factor": {
      "type": "number"
    },
    "reference_time": {
      "type": "string",
      "format": "date-time",
      "description": "Close time of the CLOSED H1 bar the decision was made on (UTC)"
    },
    "live_price_at_signal": {
      "type": "number",
      "description": "Live quote when the signal was produced, for measuring drift from the reference close"
    },
    "session": {
      "type": "string"
    },
    "vol_state": {
      "type": "string"
    },
    "news_risk": {
      "type": "string"
    },
    "valid_until": {
      "type": "string",
      "format": "date-time",
      "description": "The signal is re-evaluated on the next H1 close; after this it is stale by construction"
    },
    "data_source": {
      "type": "string"
    },
    "setup_key": {
      "type": "string",
      "description": "Unique key identifying the underlying setup, used to prevent duplicate signals"
    },
    "direction": {
      "type": "string",
      "enum": [
        "LONG",
        "SHORT",
        "NO_TRADE"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "WATCHING",
        "PENDING",
        "ACTIVE",
        "TP1_HIT",
        "TP2_HIT",
        "TP3_HIT",
        "STOPPED",
        "INVALIDATED",
        "EXPIRED"
      ],
      "default": "WATCHING"
    },
    "price_at_signal": {
      "type": "number"
    },
    "entry_low": {
      "type": "number"
    },
    "entry_high": {
      "type": "number"
    },
    "stop_loss": {
      "type": "number"
    },
    "tp1": {
      "type": "number"
    },
    "tp2": {
      "type": "number"
    },
    "tp3": {
      "type": "number"
    },
    "risk_reward": {
      "type": "number"
    },
    "confidence": {
      "type": "number",
      "description": "DEPRECATED - kept so existing records still parse. Use evidence_score. This was never a probability."
    },
    "regime": {
      "type": "string"
    },
    "conflict_level": {
      "type": "string",
      "enum": [
        "LOW",
        "MODERATE",
        "HIGH"
      ]
    },
    "scores": {
      "type": "object",
      "properties": {
        "trend": {
          "type": "number"
        },
        "structure": {
          "type": "number"
        },
        "momentum": {
          "type": "number"
        },
        "support_resistance": {
          "type": "number"
        },
        "price_action": {
          "type": "number"
        },
        "macro": {
          "type": "number"
        }
      }
    },
    "timeframe_bias": {
      "type": "object",
      "properties": {
        "D1": {
          "type": "string"
        },
        "H4": {
          "type": "string"
        },
        "H1": {
          "type": "string"
        },
        "M15": {
          "type": "string"
        },
        "M5": {
          "type": "string"
        }
      }
    },
    "reasons_for": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reasons_against": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "invalidation": {
      "type": "string"
    },
    "explanation": {
      "type": "string"
    },
    "result_r": {
      "type": "number",
      "description": "Realized R multiple once closed"
    }
  },
  "required": [
    "direction",
    "price_at_signal"
  ]
}