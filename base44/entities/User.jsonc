{
  "properties": {
    "role": {
      "type": "string",
      "description": "The role of the user in the app",
      "enum": [
        "admin",
        "user"
      ]
    },
    "trading_mode": {
      "type": "string",
      "enum": [
        "PAPER",
        "ADVISORY"
      ],
      "description": "How signals are presented. PAPER records and simulates them as research; ADVISORY presents them as actionable. Neither connects a broker. When unset, the mode is derived from the backtest verdict: ADVISORY only for PROVEN EDGE, PAPER otherwise."
    },
    "refresh_interval": {
      "type": "number",
      "description": "Dashboard auto-refresh interval in seconds"
    },
    "account_size": {
      "type": "number",
      "description": "Account size used to size positions on the trade screen. Position size is derived from this and the stop distance, never from how confident the signal looks."
    },
    "risk_pct": {
      "type": "number",
      "description": "Percent of the account risked per trade, used with the stop distance to compute position size"
    }
  },
  "required": [
    "role"
  ],
  "name": "User",
  "type": "object"
}