{
  "name": "EconomicEvent",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "event_time": {
      "type": "string",
      "format": "date-time",
      "description": "UTC event time"
    },
    "importance": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low"
      ],
      "default": "high"
    },
    "forecast": {
      "type": "string"
    },
    "previous": {
      "type": "string"
    },
    "actual": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "precision": {
      "type": "string",
      "enum": [
        "exact",
        "approximate"
      ],
      "default": "exact",
      "description": "How the timestamp was determined. 'exact' means the agency's published release rule fixes it; 'approximate' means the month is certain but the day follows the usual pattern. Only exact events are allowed to gate the strategy."
    }
  },
  "required": [
    "name",
    "event_time"
  ]
}